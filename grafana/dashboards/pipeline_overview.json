{
  "title": "Pipeline de Normalisation - Vue Globale",
  "uid": "windmill-pipeline-overview",
  "tags": ["windmill", "pipeline", "etl", "monitoring"],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "schemaVersion": 37,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "📊 Vue d'ensemble du Pipeline",
