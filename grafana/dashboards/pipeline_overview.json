          "custom": {"displayLabels": ["name", "percent"]}
        }
      },
      "options": {
        "displayLabels": ["name", "percent"],
        "legend": {"displayMode": "list", "placement": "right"}
      }
    },
    {
      "id": 9,
      "title": "📊 Statistiques des données",
      "type": "table",
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 12},
      "targets": [
        {"expr": "windmill_pipeline_raw_data_total_ratio", "refId": "A", "legendFormat": "Brutes"},
        {"expr": "windmill_pipeline_normalized_data_total_ratio", "refId": "B", "legendFormat": "Normalisées"},
        {"expr": "windmill_pipeline_rejected_data_total_ratio", "refId": "C", "legendFormat": "Rejetées"},
        {"expr": "windmill_pipeline_raw_pending_total_ratio", "refId": "D", "legendFormat": "En attente"},
        {"expr": "windmill_pipeline_raw_processing_total_ratio", "refId": "E", "legendFormat": "En traitement"}
